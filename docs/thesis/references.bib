@article{multi_camera_calibration,
  author       = {Yichao Xu and Kazuki Maeno and Hajime Nagahara and Rin-ichiro Taniguchi},
  title        = {Camera array calibration for light field acquisition},
  journal      = {Frontiers of Computer Science},
  year         = {2015},
  volume       = {9},
  number       = {5},
  pages        = {691--702},
  doi          = {10.1007/s11704-015-4237-4},
  url          = {https://link.springer.com/article/10.1007/s11704-015-4237-4},
  abstract     = {Light field cameras are becoming popular in computer vision and graphics, and camera arrays are one way to acquire a 4D light field. This paper proposes a calibration method for a camera array and a rectification method to generate a light field image, using a two-step algorithm with closed-form initialization and nonlinear refinement, extending Zhang’s calibration method to camera arrays with a rigid camera constraint to improve accuracy and efficiency.}  
}

